PORT=3000
MODE=lan
# Online production: set MODE=online and an actual HTTPS origin (no trailing path)
# PUBLIC_ORIGIN=https://rushroom-games.vercel.app
# Docker/Caddy: backend hostname pointing to your permanent VPS
# GAME_DOMAIN=game-server.your-domain.example
# Separate frontend/backend hosting: Vite build-time public backend HTTPS URL
# VITE_SERVER_ORIGIN=https://your-game-server.example
# LAN optional: select one reachable interface
# LAN_HOST=192.168.1.10
ROOM_TTL_MS=1800000
