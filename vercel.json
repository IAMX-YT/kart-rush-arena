{
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "functions": {"api/ws.ts": {"maxDuration": 300}, "api/health.ts": {"maxDuration": 30}},
  "rewrites": [
    {
      "source": "/ws",
      "destination": "/api/ws"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/((?!api/|assets/|art/|materials/|models/|wash-world.png|favicon.svg).*)",
      "destination": "/index.html"
    }
  ]
}
